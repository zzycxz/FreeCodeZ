{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/main",
    // 本工程只做类型检查（产物由 tsup 打包）——不锁 rootDir，允许 src/main 引用
    // src/scheduler 的协议类型（scheduler 是独立 tsconfig 工程，跨 rootDir 引用
    // 在锁 rootDir 时触发 TS6059/6307；2026-10-13 typecheck 清欠）。
    "lib": ["es2025"]
  },
  "include": ["src/main", "src/scheduler/schedulerProtocol.ts"],
  // main 直接依赖 shared 和 services；把引用补齐后，desktop 子工程也能稳定复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
