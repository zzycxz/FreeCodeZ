node-linker=hoisted
# 国内网络默认走 npmmirror 镜像；海外网络可改为 https://registry.npmjs.org 覆盖。
registry=https://registry.npmmirror.com
# 阻止 pnpm 在 script 运行前自动 verify-deps/安装（内部会按 registry 解析 pnpm 包，
# 且 turbo strict env 会剥离环境变量覆盖）。与 prepare-agent-node-bundle.mjs 的 pnpmRunEnv 守卫一致。
verify-deps-before-run=false
manage-package-manager-versions=false
